{
  "expo": {
    "name": "Bookworm",
    "slug": "bookworm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookworm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kenneacsteam.bookworm"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.kenneacsteam.bookworm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff5f8",
          "image": "./assets/images/splash-icon.png"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ff68ad1-8627-4606-bcda-9e77b9e664e2"
      }
    },
    "owner": "kenneacs-team"
  }
}
